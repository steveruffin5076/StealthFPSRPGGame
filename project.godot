; Engine configuration file.
; Blackout Protocol — Godot 4.3+

config_version=5

[application]

config/name="Blackout Protocol"
config/description="Stealth tactical first-person RPG in a collapsed city."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
SaveSystem="*res://autoload/save_system.gd"
SceneRouter="*res://autoload/scene_router.gd"
DataRegistry="*res://autoload/data_registry.gd"
AudioManager="*res://autoload/audio_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

